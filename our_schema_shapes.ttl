dcat:Dataset a sh:NodeShape ;
    rdfs:comment "A Dataset that was generated by an analysis of some previously generated data. For example, a dataset that contains the data of an assignment of a chemical structure to a sample based on the spectral data obtained from the sample is an AnalyticalDataset.",
        "A collection of data, published or curated by a single agent, and available for access or download in one or more representations." ;
    sh:closed true ;
    sh:ignoredProperties ( healthdcatap:numberOfRecords dcterms:alternative healthdcatap:populationCoverage dpv:hasPurpose healthdcatap:hasCodeValues healthdcatap:numberOfUniqueIndividuals healthdcatap:hasCodingSystem healthdcatap:analytics geodcatap:custodian healthdcatap:hdab healthdcatap:maxTypicalAge dpv:hasLegalBasis rdf:type healthdcatap:minTypicalAge dqv:hasQualityAnnotation healthdcatap:hasStructuredData healthdcatap:hasVariables healthdcatap:healthCategory healthdcatap:retentionPeriod dpv:hasPersonalData healthdcatap:healthTheme ),
        ( rdf:type ),
        ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:date> ;
            sh:description "The date of formal issuance (e.g., publication) of the Dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dcterms:issued ],
        [ sh:class prov:Attribution ;
            sh:description "An Agent having some form of responsibility for the resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path prov:qualifiedAttribution ],
        [ sh:datatype <xsd:string> ;
            sh:description "A free-text account of the Dataset." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ],
        [ sh:class dcterms:Standard ;
            sh:description "An implementing rule or other specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path dcterms:conformsTo ],
        [ sh:datatype <xsd:string> ;
            sh:description "A free-text account of the Dataset." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path dcterms:description ],
        [ sh:datatype <xsd:decimal> ;
            sh:description "The minimum spatial separation resolvable in a dataset, measured in meters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path dcat:spatialResolutionInMeters ],
        [ sh:datatype <xsd:string> ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:alternative ],
        [ sh:datatype <xsd:nonNegativeInteger> ;
            sh:maxCount 1 ;
