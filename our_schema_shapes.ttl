    sh:ignoredProperties ( time:hasBeginning skos:notation prov:hadRole rdf:type time:hasEnd dcatapplus:id prov:agent dcat:endDate dcat:startDate skos:prefLabel dcterms:type dcat:hadRole ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
