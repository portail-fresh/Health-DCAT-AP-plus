# Full worked HealthDataset example: a cancer registry dataset with
# agents, activities, entities, dataset-level attribution, and (on the
# DataGeneratingActivity) three qualified_association entries -- PI,
# sponsor, funder, real ISO 19115 CI_RoleCode roles, not invented. See
# docs/architecture-verification.md sections 5-6 for the full narrative.
#
# Source: tests/data/problem/valid/HealthDataset-shacl-full.yaml, built via
# tests/test_shacl_validation.py's _build_test_dataset_graph() helper --
# regenerate with that function directly (see its own docstring) after
# changing the fixture or schema. As of scripts/patch_post_init_shielding.py,
# plain HealthDataset(**data) construction needs no special workaround at
# all; the one thing this helper still does by hand is substituting
# AssociatedDataGeneratingActivity instances into was_generated_by (a
# deliberate design choice, not a bug -- see that class's own docstring in
# health_dcat_ap_plus.yaml).
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix cv: <http://data.europa.eu/m8g/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geodcatap: <http://data.europa.eu/930/> .
@prefix healthdcatap: <http://healthdataportal.eu/ns/health#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dataset/cancer-registry-2024> a dcat:Dataset ;
    geodcatap:custodian [ a foaf:Agent ;
            cv:contactPoint [ a cv:ContactPoint ;
                    cv:email "custodian@example.org" ] ;
            foaf:name "Regional Cancer Registry Authority" ] ;
    dcatap:applicableLegislation <https://example.org/legislation/eu-2025-327> ;
    healthdcatap:analytics [ a dcat:Distribution ;
            dcatap:applicableLegislation <https://example.org/legislation/eu-2025-327> ;
            dcat:accessURL <https://example.org/dataset/cancer-registry-2024/analytics> ] ;
    healthdcatap:hasCodeValues "ICD-O-3" ;
    healthdcatap:hasCodingSystem <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/coding-system/ICD_O_3> ;
    healthdcatap:hasStructuredData true ;
    healthdcatap:hdab [ a foaf:Agent ;
            cv:contactPoint [ a cv:ContactPoint ;
                    cv:email "hdab@example.org" ] ;
            foaf:name "National Health Data Access Body" ] ;
    healthdcatap:healthCategory <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/ONCOLOGY> ;
    healthdcatap:healthTheme <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-theme/CANCER> ;
    healthdcatap:maxTypicalAge "99"^^xsd:nonNegativeInteger ;
    healthdcatap:minTypicalAge "0"^^xsd:nonNegativeInteger ;
    healthdcatap:numberOfRecords "45000"^^xsd:nonNegativeInteger ;
    healthdcatap:numberOfUniqueIndividuals "42000"^^xsd:nonNegativeInteger ;
    healthdcatap:populationCoverage "National" ;
    healthdcatap:retentionPeriod [ a dcterms:PeriodOfTime ;
            dcat:endDate "2044-01-01"^^xsd:date ;
            dcat:startDate "2024-01-01"^^xsd:date ] ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ;
    dcterms:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/ANNUAL> ;
    dcterms:conformsTo <https://example.org/schemas/cancer-registry-v1> ;
    dcterms:description "Annual registry of new cancer diagnoses, regional coverage." ;
    dcterms:identifier "https://example.org/dataset/cancer-registry-2024" ;
    dcterms:isReferencedBy <https://example.org/publications/cancer-registry-report-2024> ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dcterms:provenance [ a dcterms:ProvenanceStatement ;
            dcterms:title "Collected under regional ethics approval REC-2023-114." ] ;
    dcterms:relation <https://example.org/dataset/cancer-mortality-2024> ;
    dcterms:subject <https://example.org/activity/diagnostic-reporting-process>,
        <https://example.org/population/regional-cancer-patients-2024> ;
    dcterms:temporal [ a dcterms:PeriodOfTime ;
            dcat:endDate "2024-12-31"^^xsd:date ;
            dcat:startDate "2024-01-01"^^xsd:date ] ;
    dcterms:title "Regional cancer incidence registry 2024" ;
    dcterms:type <http://publications.europa.eu/resource/authority/dataset-type/EXPLOITABLE> ;
    adms:sample [ a dcat:Distribution ;
            dcatap:applicableLegislation <https://example.org/legislation/eu-2025-327> ;
            dcat:accessURL <https://example.org/dataset/cancer-registry-2024/sample> ] ;
    dcat:contactPoint [ a vcard:Kind ;
            vcard:hasEmail "mailto:data-access@example.org" ] ;
    dcat:distribution [ a dcat:Distribution ;
            dcatap:applicableLegislation <https://example.org/legislation/eu-2025-327> ;
            dcat:accessURL <https://example.org/dataset/cancer-registry-2024/download> ] ;
    dcat:keyword "cancer",
        "registry" ;
    dcat:landingPage <https://example.org/dataset/cancer-registry-2024/landing> ;
    dcat:temporalResolution "P1D"^^xsd:duration ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dqv:hasQualityAnnotation <https://example.org/quality-certificate/iso-27001> ;
    prov:qualifiedAttribution [ a prov:Attribution ;
            dcat:hadRole <https://standards.iso.org/iso/19115/resources/Codelists/gml/CI_RoleCode.xml#processor> ;
            prov:agent [ a foaf:Agent ;
                    foaf:name "National Cancer Registry Data Processor" ] ] ;
    prov:wasGeneratedBy <https://example.org/activity/cancer-registry-collection-2024> ;
    foaf:page <https://example.org/doc/methodology> ;
    dpv:hasLegalBasis dpv:LegalObligation ;
    dpv:hasPersonalData <https://w3id.org/dpv/dpv-pd#MedicalHealthInsurance> ;
    dpv:hasPurpose dpv:MedicalResearchPurpose .

<https://example.org/activity/cancer-registry-collection-2024> a prov:Activity ;
    dcterms:title "Cancer registry data collection process" ;
    prov:qualifiedAssociation [ a prov:Association ;
            prov:agent <https://orcid.org/0000-0002-1825-0097> ;
            prov:hadRole <https://standards.iso.org/iso/19115/resources/Codelists/gml/CI_RoleCode.xml#principalInvestigator> ],
        [ a prov:Association ;
            prov:agent <https://ror.org/00k4n6c32> ;
            prov:hadRole <https://standards.iso.org/iso/19115/resources/Codelists/gml/CI_RoleCode.xml#sponsor> ],
        [ a prov:Association ;
            prov:agent <https://ror.org/03yrm5c26> ;
            prov:hadRole <https://standards.iso.org/iso/19115/resources/Codelists/gml/CI_RoleCode.xml#funder> ] .

<https://example.org/activity/diagnostic-reporting-process> a prov:Activity ;
    dcterms:title "Diagnostic reporting and coding process" .

<https://example.org/dataset/cancer-mortality-2024> a <rdfs:Resource> .

<https://example.org/dataset/cancer-registry-2024/analytics> a <rdfs:Resource> .

<https://example.org/dataset/cancer-registry-2024/download> a <rdfs:Resource> .

<https://example.org/dataset/cancer-registry-2024/landing> a foaf:Document .

<https://example.org/dataset/cancer-registry-2024/sample> a <rdfs:Resource> .

<https://example.org/doc/methodology> a foaf:Document .

<https://example.org/population/regional-cancer-patients-2024> a prov:Entity ;
    dcterms:title "Regional cancer patient population, 2024 cohort" .

<https://example.org/publications/cancer-registry-report-2024> a <rdfs:Resource> .

<https://orcid.org/0000-0002-1825-0097> a prov:Agent ;
    dcterms:title "Dr. Maria Santos" .

<https://ror.org/00k4n6c32> a prov:Agent ;
    dcterms:title "National Institute of Public Health" .

<https://ror.org/03yrm5c26> a prov:Agent ;
    dcterms:title "European Health Research Council" .

<https://example.org/legislation/eu-2025-327> a <eli:LegalResource> .

