# Full worked HealthDataset example: a cancer registry dataset with
# agents, activities, entities, dataset-level attribution, and (on the
# DataGeneratingActivity) three qualified_association entries -- PI,
# sponsor, funder, real ISO 19115 CI_RoleCode roles, not invented. See
# docs/architecture-verification.md sections 5-6 for the full narrative.
#
# Source: tests/data/problem/valid/HealthDataset-shacl-full.yaml.
# Regenerate with `.venv/Scripts/python scripts/gen_example.py` (see that
# script's own docstring) after changing the fixture or schema.
#
# A self-contained document in HealthDCAT-AP's own style (release 8):
#   * the dataset's dct:source is a second dataset described in the same
#     graph, because DCAT-AP's shape wants a dct:source value to be a
#     dcat:Dataset (and so to satisfy the dataset shapes itself);
#   * every external term whose shape checks a plain class is typed inline
#     (`<term> a dct:Frequency .` and so on, at the end of the file), as the
#     official example does -- the official validator's vocabulary catalogue
#     does not supply those types. Terms checked through skos:inScheme are
#     not typed, as in the official example.
#
# Every external vocabulary/ontology term below was checked against its own
# real source, not assumed -- see the fixture YAML's comments and
# tests/data/real_vocabulary_terms.ttl for what was verified and how.
# applicable_legislation points at the real ELI for Regulation (EU) 2025/327,
# the EHDS Regulation itself. The personal-data term is not a DPV IRI: see the
# fixture's comment on has_personal_data.
#
# Validated against the merged shapes graph by
# tests/test_shacl_validation.py::test_published_example_conforms_to_merged_shacl
# (walked through in examples/HealthDataset-validation-check.ipynb): no
# violation, and warnings only for recommended properties this example leaves
# out. See the "thirteenth" and "fourteenth" findings of
# docs/architecture-verification.md.

@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix cv: <http://data.europa.eu/m8g/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geodcatap: <http://data.europa.eu/930/> .
@prefix healthdcatap: <http://healthdataportal.eu/ns/health#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dataset/cancer-registry-2024> a dcat:Dataset ;
    geodcatap:custodian [ a foaf:Agent ;
            cv:contactPoint [ a cv:ContactPoint ;
                    cv:email "custodian@example.org" ] ;
            foaf:name "Regional Cancer Registry Authority" ] ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    healthdcatap:analytics [ a dcat:Distribution ;
            dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
            dcat:accessURL <https://example.org/dataset/cancer-registry-2024/analytics> ] ;
    healthdcatap:hasCodeValues "ICD-O" ;
    healthdcatap:hasCodingSystem <https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system/ICD-O> ;
    healthdcatap:hasStructuredData true ;
    healthdcatap:hasVariables [ a csvw:TableGroup ;
            dct:title "Cancer registry variables dictionary" ;
            csvw:table [ a csvw:Table ;
                    dct:title "Variable inventory for the cancer registry" ;
                    csvw:column [ a csvw:Column ;
                            dct:description "Pseudonymised identifier of the registered patient." ;
                            csvw:datatype "string" ;
                            csvw:name "patientId" ;
                            csvw:title "Patient identifier" ],
                        [ a csvw:Column ;
                            dct:description "Stage of the tumour at diagnosis." ;
                            csvw:datatype "string" ;
                            csvw:name "tumourStage" ;
                            csvw:propertyUrl <https://example.org/vocab/tumourStage> ;
                            csvw:title "Tumour stage" ] ;
                    csvw:url <https://example.org/dataset/cancer-registry-2024/variables.csv> ;
                    dcat:keyword "cancer",
                        "variables" ] ] ;
    healthdcatap:hdab [ a foaf:Agent ;
            cv:contactPoint [ a cv:ContactPoint ;
                    cv:email "hdab@example.org" ;
                    cv:openingHours [ a time:TemporalEntity ;
                            cv:frequency <http://publications.europa.eu/resource/authority/frequency/DAILY> ;
                            dct:description "Every working day from 09:00 to 17:00 CET." ] ] ;
            foaf:name "National Health Data Access Body" ] ;
    healthdcatap:hdabCoordinator [ a foaf:Agent ;
            cv:contactPoint [ a cv:ContactPoint ;
                    cv:email "hdab-coordinator@example.org" ] ;
            foaf:name "National Health Data Access Body Coordinator" ] ;
    healthdcatap:healthCategory <https://hdeu-dcat.data.health.europa.eu/resource/authority/healthcategories/PHDR> ;
    healthdcatap:healthTheme <https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/CANCER_DISEASE> ;
    healthdcatap:maxTypicalAge "99"^^xsd:nonNegativeInteger ;
    healthdcatap:minTypicalAge "0"^^xsd:nonNegativeInteger ;
    healthdcatap:numberOfRecords "45000"^^xsd:nonNegativeInteger ;
    healthdcatap:numberOfUniqueIndividuals "42000"^^xsd:nonNegativeInteger ;
    healthdcatap:populationCoverage "National" ;
    healthdcatap:retentionPeriod [ a dct:PeriodOfTime ;
            dcat:endDate "2044-01-01"^^xsd:date ;
            dcat:startDate "2024-01-01"^^xsd:date ] ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/ANNUAL> ;
    dct:conformsTo <https://hdeu-dcat.data.health.europa.eu/resource/authority/standard/FHIR> ;
    dct:description "Annual registry of new cancer diagnoses, regional coverage." ;
    dct:identifier "https://example.org/dataset/cancer-registry-2024" ;
    dct:isReferencedBy <https://example.org/publications/cancer-registry-report-2024> ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:provenance [ a dct:ProvenanceStatement ;
            dct:title "Collected under regional ethics approval REC-2023-114." ] ;
    dct:relation <https://example.org/dataset/cancer-mortality-2024> ;
    dct:source <https://example.org/dataset/hospital-case-reports-2024> ;
    dct:subject <https://example.org/activity/diagnostic-reporting-process>,
        <https://example.org/population/regional-cancer-patients-2024> ;
    dct:temporal [ a dct:PeriodOfTime ;
            dcat:endDate "2024-12-31"^^xsd:date ;
            dcat:startDate "2024-01-01"^^xsd:date ] ;
    dct:title "Regional cancer incidence registry 2024" ;
    dct:type <http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL> ;
    adms:sample [ a dcat:Distribution ;
            dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
            dcat:accessURL <https://example.org/dataset/cancer-registry-2024/sample> ] ;
    dcat:contactPoint [ a vcard:Kind ;
            vcard:hasEmail <mailto:data-access@example.org> ] ;
    dcat:distribution [ a dcat:Distribution ;
            dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
            dcat:accessURL <https://example.org/dataset/cancer-registry-2024/download> ] ;
    dcat:keyword "cancer",
        "registry" ;
    dcat:landingPage <https://example.org/dataset/cancer-registry-2024/landing> ;
    dcat:temporalResolution "P1D"^^xsd:duration ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dqv:hasQualityAnnotation <https://example.org/quality-certificate/iso-27001> ;
    prov:qualifiedAttribution [ a prov:Attribution ;
            dcat:hadRole <https://standards.iso.org/iso/19115/resources/Codelists/gml/CI_RoleCode.xml#processor> ;
            prov:agent [ a foaf:Agent ;
                    foaf:name "National Cancer Registry Data Processor" ] ] ;
    prov:wasGeneratedBy <https://example.org/activity/cancer-registry-collection-2024> ;
    foaf:page <https://example.org/doc/methodology> ;
    dpv:hasLegalBasis dpv:LegalObligation ;
    dpv:hasPersonalData <https://w3id.org/dpv/dpv-pd#MedicalHealth> ;
    dpv:hasPurpose dpv:ScientificResearch .

<https://example.org/dataset/hospital-case-reports-2024> a dcat:Dataset ;
    geodcatap:custodian [ a foaf:Agent ;
            cv:contactPoint [ a cv:ContactPoint ;
                    cv:email "custodian@example.org" ] ;
            foaf:name "Regional Cancer Registry Authority" ] ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    healthdcatap:analytics [ a dcat:Distribution ;
            dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
            dcat:accessURL <https://example.org/dataset/cancer-registry-2024/analytics> ] ;
    healthdcatap:hasCodeValues "ICD-O" ;
    healthdcatap:hasCodingSystem <https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system/ICD-O> ;
    healthdcatap:hasStructuredData true ;
    healthdcatap:hasVariables [ a csvw:TableGroup ;
            dct:title "Cancer registry variables dictionary" ;
            csvw:table [ a csvw:Table ;
                    dct:title "Variable inventory for the cancer registry" ;
                    csvw:column [ a csvw:Column ;
                            dct:description "Pseudonymised identifier of the registered patient." ;
                            csvw:datatype "string" ;
                            csvw:name "patientId" ;
                            csvw:title "Patient identifier" ],
                        [ a csvw:Column ;
                            dct:description "Stage of the tumour at diagnosis." ;
                            csvw:datatype "string" ;
                            csvw:name "tumourStage" ;
                            csvw:propertyUrl <https://example.org/vocab/tumourStage> ;
                            csvw:title "Tumour stage" ] ;
                    csvw:url <https://example.org/dataset/cancer-registry-2024/variables.csv> ;
                    dcat:keyword "cancer",
                        "variables" ] ] ;
    healthdcatap:hdab [ a foaf:Agent ;
            cv:contactPoint [ a cv:ContactPoint ;
                    cv:email "hdab@example.org" ;
                    cv:openingHours [ a time:TemporalEntity ;
                            cv:frequency <http://publications.europa.eu/resource/authority/frequency/DAILY> ;
                            dct:description "Every working day from 09:00 to 17:00 CET." ] ] ;
            foaf:name "National Health Data Access Body" ] ;
    healthdcatap:hdabCoordinator [ a foaf:Agent ;
            cv:contactPoint [ a cv:ContactPoint ;
                    cv:email "hdab-coordinator@example.org" ] ;
            foaf:name "National Health Data Access Body Coordinator" ] ;
    healthdcatap:healthCategory <https://hdeu-dcat.data.health.europa.eu/resource/authority/healthcategories/PHDR> ;
    healthdcatap:healthTheme <https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/CANCER_DISEASE> ;
    healthdcatap:maxTypicalAge "99"^^xsd:nonNegativeInteger ;
    healthdcatap:minTypicalAge "0"^^xsd:nonNegativeInteger ;
    healthdcatap:numberOfRecords "45000"^^xsd:nonNegativeInteger ;
    healthdcatap:numberOfUniqueIndividuals "42000"^^xsd:nonNegativeInteger ;
    healthdcatap:populationCoverage "National" ;
    healthdcatap:retentionPeriod [ a dct:PeriodOfTime ;
            dcat:endDate "2044-01-01"^^xsd:date ;
            dcat:startDate "2024-01-01"^^xsd:date ] ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/ANNUAL> ;
    dct:conformsTo <https://hdeu-dcat.data.health.europa.eu/resource/authority/standard/FHIR> ;
    dct:description "The hospital case reports the registry's diagnoses are collected from." ;
    dct:identifier "https://example.org/dataset/hospital-case-reports-2024" ;
    dct:isReferencedBy <https://example.org/publications/cancer-registry-report-2024> ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:provenance [ a dct:ProvenanceStatement ;
            dct:title "Collected under regional ethics approval REC-2023-114." ] ;
    dct:relation <https://example.org/dataset/cancer-mortality-2024> ;
    dct:subject <https://example.org/activity/diagnostic-reporting-process>,
        <https://example.org/population/regional-cancer-patients-2024> ;
    dct:temporal [ a dct:PeriodOfTime ;
            dcat:endDate "2024-12-31"^^xsd:date ;
            dcat:startDate "2024-01-01"^^xsd:date ] ;
    dct:title "Hospital case reports 2024" ;
    dct:type <http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL> ;
    adms:sample [ a dcat:Distribution ;
            dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
            dcat:accessURL <https://example.org/dataset/cancer-registry-2024/sample> ] ;
    dcat:contactPoint [ a vcard:Kind ;
            vcard:hasEmail <mailto:data-access@example.org> ] ;
    dcat:distribution [ a dcat:Distribution ;
            dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
            dcat:accessURL <https://example.org/dataset/cancer-registry-2024/download> ] ;
    dcat:keyword "cancer",
        "registry" ;
    dcat:landingPage <https://example.org/dataset/cancer-registry-2024/landing> ;
    dcat:temporalResolution "P1D"^^xsd:duration ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dqv:hasQualityAnnotation <https://example.org/quality-certificate/iso-27001> ;
    prov:qualifiedAttribution [ a prov:Attribution ;
            dcat:hadRole <https://standards.iso.org/iso/19115/resources/Codelists/gml/CI_RoleCode.xml#processor> ;
            prov:agent [ a foaf:Agent ;
                    foaf:name "National Cancer Registry Data Processor" ] ] ;
    prov:wasGeneratedBy <https://example.org/activity/cancer-registry-collection-2024> ;
    foaf:page <https://example.org/doc/methodology> ;
    dpv:hasLegalBasis dpv:LegalObligation ;
    dpv:hasPersonalData <https://w3id.org/dpv/dpv-pd#MedicalHealth> ;
    dpv:hasPurpose dpv:ScientificResearch .

<http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> a dct:RightsStatement .

<http://publications.europa.eu/resource/authority/frequency/ANNUAL> a dct:Frequency .

<http://publications.europa.eu/resource/authority/frequency/DAILY> a dct:Frequency .

<http://publications.europa.eu/resource/authority/language/ENG> a dct:LinguisticSystem .

<https://example.org/activity/cancer-registry-collection-2024> a prov:Activity ;
    dct:title "Cancer registry data collection process" ;
    prov:qualifiedAssociation [ a prov:Association ;
            prov:agent <https://ror.org/03yrm5c26> ;
            prov:hadRole <https://standards.iso.org/iso/19115/resources/Codelists/gml/CI_RoleCode.xml#funder> ],
        [ a prov:Association ;
            prov:agent <https://ror.org/03yrm5c26> ;
            prov:hadRole <https://standards.iso.org/iso/19115/resources/Codelists/gml/CI_RoleCode.xml#funder> ],
        [ a prov:Association ;
            prov:agent <https://ror.org/00k4n6c32> ;
            prov:hadRole <https://standards.iso.org/iso/19115/resources/Codelists/gml/CI_RoleCode.xml#sponsor> ],
        [ a prov:Association ;
            prov:agent <https://ror.org/00k4n6c32> ;
            prov:hadRole <https://standards.iso.org/iso/19115/resources/Codelists/gml/CI_RoleCode.xml#sponsor> ],
        [ a prov:Association ;
            prov:agent <https://orcid.org/0000-0002-1825-0097> ;
            prov:hadRole <https://standards.iso.org/iso/19115/resources/Codelists/gml/CI_RoleCode.xml#principalInvestigator> ],
        [ a prov:Association ;
            prov:agent <https://orcid.org/0000-0002-1825-0097> ;
            prov:hadRole <https://standards.iso.org/iso/19115/resources/Codelists/gml/CI_RoleCode.xml#principalInvestigator> ] .

<https://example.org/activity/diagnostic-reporting-process> a prov:Activity ;
    dct:title "Diagnostic reporting and coding process" .

<https://example.org/dataset/cancer-mortality-2024> a rdfs:Resource .

<https://example.org/dataset/cancer-registry-2024/analytics> a rdfs:Resource .

<https://example.org/dataset/cancer-registry-2024/download> a rdfs:Resource .

<https://example.org/dataset/cancer-registry-2024/landing> a foaf:Document .

<https://example.org/dataset/cancer-registry-2024/sample> a rdfs:Resource .

<https://example.org/doc/methodology> a foaf:Document .

<https://example.org/population/regional-cancer-patients-2024> a prov:Entity ;
    dct:title "Regional cancer patient population, 2024 cohort" .

<https://example.org/publications/cancer-registry-report-2024> a rdfs:Resource .

<https://example.org/quality-certificate/iso-27001> a dqv:QualityCertificate .

<https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system/ICD-O> a dct:Standard .

<https://hdeu-dcat.data.health.europa.eu/resource/authority/standard/FHIR> a dct:Standard .

<https://orcid.org/0000-0002-1825-0097> a prov:Agent ;
    dct:title "Dr. Maria Santos" .

<https://ror.org/00k4n6c32> a prov:Agent ;
    dct:title "National Institute of Public Health" .

<https://ror.org/03yrm5c26> a prov:Agent ;
    dct:title "European Health Research Council" .

dpv:LegalObligation a dpv:LegalBasis .

dpv:ScientificResearch a dpv:Purpose .

