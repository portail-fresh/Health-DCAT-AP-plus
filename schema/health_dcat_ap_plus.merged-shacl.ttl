# health_dcat_ap_plus.merged-shacl.ttl -- GENERATED FILE, do not edit by
# hand. Regenerate with `just gen-shacl` (see scripts/gen_merged_shacl.py's
# own docstring for the full mechanism and why a naive union of every
# generated shape doesn't work).
#
# This file combines two things:
#
#   1. HealthDCAT-AP's own real, official upstream SHACL shapes (release 7,
#      non-public tier: deprecateduris.ttl, range.ttl,
#      mdr-vocabularies.shape.ttl, non-public-shapes.ttl,
#      non-public-shapes_recommended.ttl), Copyright (c) 2025 European
#      Union, published under CC-BY 4.0
#      (https://creativecommons.org/licenses/by/4.0/) -- see
#      https://code.europa.eu/healthdataeu/healthdcat-ap. Included here
#      with two small upstream bug fixes applied (a missing trailing slash
#      in the dcatap: prefix declaration; one malformed sh:property triple
#      with no sh:path removed) -- see scripts/gen_merged_shacl.py for both.
#
#   2. This schema's own generated SHACL for everything the real shapes
#      above don't cover -- the Activity/Association/Attribution/Entity
#      side (DataGeneratingActivity, AgenticEntity, Plan, and their
#      subclasses) -- with NodeShapes for Dataset/Distribution/Agent/
#      Catalog/vocabulary-stub classes deliberately excluded, since the
#      real shapes above already own those.
#
# Source: src/health_dcat_ap_plus/schema/health_dcat_ap_plus.yaml

@prefix : <https://semiceu.github.io/DCAT-AP/releases/3.0.0/html/shacl/shapes.ttl#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix cv: <http://data.europa.eu/m8g/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix default1: <http://data.europa.eu/r5r#> .
@prefix default2: <https://semiceu.github.io/DCAT-AP/releases/3.0.0/html/shacl/range.ttl#> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geodcatap: <http://data.europa.eu/930/> .
@prefix healthdcatap: <http://healthdataportal.eu/ns/health#> .
@prefix lcon: <http://www.w3.org/ns/locn#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

default1:Catalog_ShapeCV a sh:NodeShape ;
    sh:property [ sh:message "A non-EU managed concept is used to indicate the language. Please align with a concept from http://publications.europa.eu/resource/authority/language. If no match is found, inform the maintainer of the EU language NAL." ;
            sh:node default1:LanguageRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:language ;
            sh:severity sh:Violation ],
        [ sh:message "A non EU managed concept is used to indicate the publisher, check if a corresponding exists in the EU corporates bodies NAL" ;
            sh:node default1:CorporateBodyRestriction,
                default1:Publisher_ShapeCV ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:publisher ;
            sh:severity sh:Warning ],
        [ sh:message "A non-managed concept is used to indicate a spatial description. Please align with a concept from one of the following sources: https://publications.europa.eu/resource/authority/continent, https://publications.europa.eu/resource/authority/country, https://publications.europa.eu/resource/authority/place, https://sws.geonames.org/. check if a corresponding exists." ;
            sh:node [ a sh:NodeShape ;
                    sh:or ( default1:CountryRestriction default1:PlaceRestriction default1:ContinentRestriction default1:GeoNamesRestriction ) ] ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:spatial ;
            sh:severity sh:Warning ],
        [ sh:hasValue <http://publications.europa.eu/resource/authority/data-theme> ;
            sh:message "Multiple themes can be used but at least <http://publications.europa.eu/resource/authority/data-theme> should be present" ;
            sh:nodeKind sh:IRI ;
            sh:path dcat:themeTaxonomy ;
            sh:severity sh:Warning ] ;
    sh:targetClass dcat:Catalog .

default1:Checksum_ShapeCV a sh:NodeShape ;
    sh:property [ sh:node default1:ChecksumAlgorithmRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path spdx:algorithm ] ;
    sh:targetClass spdx:Checksum .

default1:DataService_ShapeCV a sh:NodeShape ;
    sh:property [ sh:message "A non-EU managed concept is used to indicate the access right. Please align with a concept from http://publications.europa.eu/resource/authority/access-right. If no match is found, inform the maintainer of the EU access-right NAL." ;
            sh:node default1:AccessRightRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:accessRights ;
            sh:severity sh:Violation ],
        [ sh:message "A non-EU managed concept is used to indicate the file format. Please align with a concept from http://publications.europa.eu/resource/authority/file-type. If no match is found, inform the maintainer of the EU file-type NAL." ;
            sh:node default1:FileTypeRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:format ;
            sh:severity sh:Violation ] ;
    sh:targetClass dcat:DataService .

default1:DatasetDeprecation_Shape a sh:NodeShape ;
    rdfs:label "Dataset Deprecation properties"@en ;
    sh:property [ sh:message "replace property dct:hasVersion with dcat:hasVersion"@en ;
            sh:path dcterms:hasVersion ;
            sh:severity sh:Warning ],
        [ sh:message "replace dct:isVersionOf with dcat:isVersionOf"@en ;
            sh:path dcterms:isVersionOf ;
            sh:severity sh:Warning ],
        [ sh:message "replace owl:versionInfo with dcat:version"@en ;
            sh:path owl:versionInfo ;
            sh:severity sh:Warning ] ;
    sh:targetClass dcat:Dataset .

default1:Dataset_Shape a sh:NodeShape ;
    rdfs:label "Dataset"@en ;
    sh:property [ sh:minCount 1 ;
            sh:path healthdcatap:analytics ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path dpv:hasLegalBasis ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path healthdcatap:maxTypicalAge ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path healthdcatap:minTypicalAge ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path healthdcatap:numberOfRecords ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path healthdcatap:numberOfUniqueIndividuals ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path dpv:hasPersonalData ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path healthdcatap:populationCoverage ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path dpv:hasPurpose ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path dqv:hasQualityAnnotation ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path healthdcatap:retentionPeriod ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path healthdcatap:hasCodeValues ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path adms:sample ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path dcterms:temporal ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path dcat:temporalResolution ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path dcat:landingPage ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path dcterms:relation ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path geodcatap:custodian ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path healthdcatap:hasCodingSystem ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path dcterms:conformsTo ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path foaf:page ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path dcterms:accrualPeriodicity ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path healthdcatap:healthTheme ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path dcterms:isReferencedBy ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path dcterms:language ;
            sh:severity sh:Warning ] ;
    sh:targetClass dcat:Dataset .

default1:Dataset_ShapeCV a sh:NodeShape ;
    sh:property [ sh:message "A non-EU managed concept is used to indicate the accrualPeriodicity frequency. Please align with a concept from http://publications.europa.eu/resource/authority/frequency. If no match is found, inform the maintainer of the EU frequency NAL." ;
            sh:node default1:FrequencyRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:accrualPeriodicity ;
            sh:severity sh:Violation ],
        [ sh:message "A non-EU managed concept is used to indicate the language. Please align with a concept from http://publications.europa.eu/resource/authority/language. If no match is found, inform the maintainer of the EU language NAL." ;
            sh:node default1:LanguageRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:language ;
            sh:severity sh:Violation ],
        [ sh:message "A non-EU managed concept is used to indicate the publisher type. Please align with a concept from https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/publisher-type. If no match is found, inform the maintainer of the EU publisher-type NAL." ;
            sh:node default1:HealthPublisherAgent_ShapeCV ;
            sh:path dcterms:publisher ;
            sh:severity sh:Violation ],
        [ sh:message "A non-managed concept is used to indicate a spatial description. Please align with a concept from one of the following sources: https://publications.europa.eu/resource/authority/continent, https://publications.europa.eu/resource/authority/country, https://publications.europa.eu/resource/authority/place, https://sws.geonames.org/. check if a corresponding exists." ;
            sh:node [ a sh:NodeShape ;
                    sh:or ( default1:CountryRestriction default1:PlaceRestriction default1:ContinentRestriction default1:GeoNamesRestriction ) ] ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:spatial ;
            sh:severity sh:Warning ],
        [ sh:message "A non-EU managed concept is used to indicate the dataset theme. Please align with a concept from http://publications.europa.eu/resource/authority/data-theme If no match is found, inform the maintainer of the EU data-theme NAL." ;
            sh:node default1:DataThemeRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcat:theme ;
            sh:severity sh:Violation ],
        [ sh:hasValue <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
            sh:message "Dataset must include theme http://publications.europa.eu/resource/authority/data-theme/HEAL." ;
            sh:minCount 1 ;
            sh:path dcat:theme ;
            sh:severity sh:Violation ],
        [ sh:message "Multiple types can be used but it is recommended to also provide at least one concept of <http://publications.europa.eu/resource/authority/dataset-type> should be present" ;
            sh:node default1:DatasetTypeRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:type ;
            sh:severity sh:Warning ],
        [ sh:message "A non-EU managed concept is used to indicate the access right. Please align with a concept from http://publications.europa.eu/resource/authority/access-right. If no match is found, inform the maintainer of the EU access rights NAL." ;
            sh:node default1:AccessRightRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:accessRights ;
            sh:severity sh:Violation ],
        [ sh:description "A health Category According to the Article 51 of EHDS regulation." ;
            sh:message "A non-EU managed concept is used to indicate the health category. Please align with a concept from https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories, based on Article 51 of the EHDS regulation." ;
            sh:node default1:HealthCategoryRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path healthdcatap:healthCategory ;
            sh:severity sh:Violation ],
        [ sh:message "A non-EU managed concept is used to indicate the coding system. Please align with a concept from https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/coding-system. If no match is found, inform the vocabulary maintainer." ;
            sh:node default1:HasCodingSystemRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path healthdcatap:hasCodingSystem ;
            sh:severity sh:Violation ],
        [ sh:message "A non-EU managed concept is used to indicate the standard (dct:conformsTo). Please align with a concept from https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/standard. If no match is found, inform the vocabulary maintainer." ;
            sh:node default1:ConformsToRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:conformsTo ;
            sh:severity sh:Violation ],
        [ sh:message "A non-EU managed concept is used to indicate the health theme. Please align with a concept from https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-theme. If no match is found, inform the maintainer of the EU health-theme NAL." ;
            sh:node default1:HealthThemeRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path healthdcatap:healthTheme ;
            sh:severity sh:Violation ],
        [ sh:message "A non-EU managed concept is used to indicate the health activity type. Please align with a concept from https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-activity. If no match is found, inform the maintainer of the EU health-activity NAL." ;
            sh:node default1:HealthActivity_ShapeCV ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path prov:wasGeneratedBy ;
            sh:severity sh:Violation ] ;
    sh:targetClass dcat:Dataset .

default1:Distribution_ShapeCV a sh:NodeShape ;
    sh:property [ sh:message "A non-EU managed concept is used to indicate the file format. Please align with a concept from http://publications.europa.eu/resource/authority/file-type. If no match is found, inform the maintainer of the EU file-type NAL." ;
            sh:node default1:FileTypeRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:format ;
            sh:severity sh:Violation ],
        [ sh:message "A non-EU managed concept is used to indicate the language. Please align with a concept from http://publications.europa.eu/resource/authority/language. If no match is found, inform the maintainer of the EU language NAL." ;
            sh:node default1:LanguageRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:language ;
            sh:severity sh:Violation ],
        [ sh:message "A non-EU managed concept is used to indicate the distribution status. Please align with a concept from http://publications.europa.eu/resource/authority/distribution-status. If no match is found, inform the maintainer of the EU distribution-status NAL." ;
            sh:node default1:StatusRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path adms:status ;
            sh:severity sh:Violation ],
        [ sh:message "A non-EU managed concept is used to indicate the availability of the distribution. Please align with a concept from http://publications.europa.eu/resource/authority/planned-availability. If no match is found, inform the maintainer of the EU planned-availability NAL." ;
            sh:node default1:AvailabilityRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcatap:availability ;
            sh:severity sh:Violation ],
        [ sh:message "A non-IANA managed concept is used to indicate the mediaType. Please align with a value from IANA: https://www.iana.org/assignments/media-types/. If no match is found, inform the responsible maintainer." ;
            sh:node default1:IANARestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcat:mediaType ;
            sh:severity sh:Warning ],
        [ sh:message "A non-IANA managed concept is used to indicate the compressFormat. Please align with a value from IANA: https://www.iana.org/assignments/media-types/. If no match is found, inform the responsible maintainer." ;
            sh:node default1:IANARestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcat:compressFormat ;
            sh:severity sh:Warning ],
        [ sh:message "A non-IANA managed concept is used to indicate the packageFormat. Please align with a value from IANA: https://www.iana.org/assignments/media-types/. If no match is found, inform the responsible maintainer." ;
            sh:node default1:IANARestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcat:packageFormat ;
            sh:severity sh:Warning ] ;
    sh:targetClass dcat:Distribution .

default1:LicenseDocument_ShapeCV a sh:NodeShape ;
    sh:property [ sh:node default1:LicenceTypeRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:type ] ;
    sh:targetClass dcterms:LicenseDocument .

default1:PeriodOfTimeDeprecation_Shape a sh:NodeShape ;
    rdfs:label "PeriodOfTime Deprecation properties"@en ;
    sh:property [ sh:message "replace property schema:endDate with dcat:endDate"@en ;
            sh:path schema1:endDate ;
            sh:severity sh:Warning ],
        [ sh:message "replace property schema:startDate with dcat:startDate"@en ;
            sh:path schema1:startDate ;
            sh:severity sh:Warning ] ;
    sh:targetClass dcterms:PeriodOfTime .

default1:TemporalEntity_ShapeCV a sh:NodeShape ;
    rdfs:label "Temporal Entity" ;
    rdfs:comment "Temporal Entity constraints for opening hours" ;
    sh:property [ sh:message "A non-EU managed concept is used to indicate the TemporalEntity frequency. Please align with a concept from http://publications.europa.eu/resource/authority/frequency. If no match is found, inform the maintainer of the EU frequency NAL." ;
            sh:node default1:FrequencyRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path cv:frequency ;
            sh:severity sh:Violation ] ;
    sh:targetClass time:TemporalEntity .

<https://code.europa.eu/healthdataeu/healthdcat-ap/range.ttl> dcterms:conformsTo <https://www.w3.org/TR/shacl> ;
    dcterms:description "This file defines the SHACL class range constraints applied to DCAT-AP properties."@en ;
    dcterms:format <http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE> .

<https://code.europa.eu/healthdataeu/healthdcat-ap/shapes.ttl> dcterms:conformsTo <https://www.w3.org/TR/shacl> ;
    dcterms:description "This file defines the core SHACL constraints used by HealthDCAT-AP to validate classes and properties."@en ;
    dcterms:format <http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE> .

<https://code.europa.eu/healthdataeu/healthdcat-ap/shapes_recommended.ttl> dcterms:conformsTo <https://www.w3.org/TR/shacl> ;
    dcterms:description "This file defines the recommended SHACL constraints used by HealthDCAT-AP to support additional metadata quality for NON_PUBLIC data."@en ;
    dcterms:format <http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE> .

<https://healthdcat-ap.github.io/mdr-vocabularies.shape.ttl> dcterms:description "This file contains the controlled vocabulary constraints used in HealthDCAT-AP. It ensures that property values are taken from approved reference lists and code lists."@en .

default2:CSVWTableGroup_Shape a sh:NodeShape ;
    rdfs:label "Csvw Table Group"@en ;
    sh:property [ sh:class csvw:Table ;
            sh:path csvw:table ;
            sh:severity sh:Violation ] ;
    sh:targetClass csvw:TableGroup .

default2:CSVWTable_Shape a sh:NodeShape ;
    rdfs:label "Csvw Table"@en ;
    sh:property [ sh:class csvw:Column ;
            sh:path csvw:column ;
            sh:severity sh:Violation ] ;
    sh:targetClass csvw:Table .

default2:Dataset_Shape a sh:NodeShape ;
    rdfs:label "Dataset"@en ;
    sh:property [ sh:class dcat:Distribution ;
            sh:path healthdcatap:analytics ;
            sh:severity sh:Violation ],
        [ sh:path healthdcatap:hasCodeValues ;
            sh:severity sh:Violation ],
        [ sh:class dcterms:Standard ;
            sh:path healthdcatap:hasCodingSystem ;
            sh:severity sh:Violation ],
        [ sh:class dcterms:PeriodOfTime ;
            sh:path healthdcatap:retentionPeriod ;
            sh:severity sh:Violation ],
        [ sh:class dpv:Purpose ;
            sh:path dpv:hasPurpose ;
            sh:severity sh:Violation ],
        [ sh:class foaf:Agent ;
            sh:path healthdcatap:hdab ;
            sh:severity sh:Violation ],
        [ sh:class skos:Concept ;
            sh:path healthdcatap:healthCategory ;
            sh:severity sh:Violation ],
        [ sh:class skos:Concept ;
            sh:path healthdcatap:healthTheme ;
            sh:severity sh:Violation ],
        [ sh:class dpv:LegalBasis ;
            sh:path dpv:hasLegalBasis ;
            sh:severity sh:Violation ],
        [ sh:class dpv:PersonalData ;
            sh:path dpv:hasPersonalData ;
            sh:severity sh:Violation ],
        [ sh:class dqv:QualityCertificate ;
            sh:path dqv:hasQualityAnnotation ;
            sh:severity sh:Violation ],
        [ sh:class csvw:TableGroup ;
            sh:path healthdcatap:hasVariables ;
            sh:severity sh:Violation ] ;
    sh:targetClass dcat:Dataset .

:CSVWTableShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "Each csvw:Table must have at most one valid URL (csvw:url) as an IRI." ;
            sh:nodeKind sh:IRI ;
            sh:path csvw:url ;
            sh:severity sh:Violation ],
        [ sh:message "Each csvw:Table must have at least one title (dct:title) as a literal." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dcterms:title ;
            sh:severity sh:Violation ],
        [ sh:message "Each csvw:Table should have one or many keyword (dcat:keyword) as a literal." ;
            sh:nodeKind sh:Literal ;
            sh:path dcat:keyword ;
            sh:severity sh:Violation ],
        [ sh:message "Each csvw:Table must have at least one column (csvw:column) defined as a blank node or IRI." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path csvw:column ;
            sh:severity sh:Violation ],
        [ sh:node :CSVWColumnShape ;
            sh:path csvw:column ;
            sh:severity sh:Violation ] ;
    sh:targetClass csvw:Table .

:Catalog_Shape a sh:NodeShape ;
    rdfs:label "Catalog"@en ;
    sh:property [ sh:message "dcatap:applicableLegislation for dcat:Catalogue is required." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dcatap:applicableLegislation ;
            sh:severity sh:Violation ] ;
    sh:targetClass dcat:Catalog .

:ContactPoint_Shape a sh:NodeShape ;
    rdfs:label "Contact Point" ;
    rdfs:comment "Contact Point constraints for hdab, custodian and publisher of Dataset, must have at least one of cv:email or cv:contactPage" ;
    sh:property [ sh:message "cv:email must be a literal value." ;
            sh:nodeKind sh:Literal ;
            sh:path cv:email ;
            sh:severity sh:Violation ],
        [ sh:message "cv:contactPage must be an IRI." ;
            sh:nodeKind sh:IRI ;
            sh:path cv:contactPage ;
            sh:severity sh:Violation ],
        [ sh:message "cv:telephone must be a literal value." ;
            sh:nodeKind sh:Literal ;
            sh:path cv:telephone ;
            sh:severity sh:Violation ],
        [ sh:class time:TemporalEntity ;
            sh:message "cv:openingHours must be a time:TemporalEntity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path cv:openingHours ;
            sh:severity sh:Violation ],
        [ sh:class time:TemporalEntity ;
            sh:message "cv:specialOpeningHoursSpecification must be a time:TemporalEntity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path cv:specialOpeningHoursSpecification ;
            sh:severity sh:Violation ],
        [ sh:message "Provide at least one of cv:email or cv:contactPage." ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( cv:email cv:contactPage ) ] ;
            sh:severity sh:Violation ] ;
    sh:targetClass cv:ContactPoint .

:DatasetSeries_Shape a sh:NodeShape ;
    rdfs:label "Dataset Series"@en ;
    sh:property [ sh:message "A dcatap:applicableLegislation for dcat:DatasetSeries is required." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dcatap:applicableLegislation ;
            sh:severity sh:Violation ] ;
    sh:targetClass dcat:DatasetSeries .

:Dataset_Shape a sh:NodeShape ;
    rdfs:label "Dataset"@en ;
    sh:property [ sh:message "Each dcat:Dataset must have at least one dcat:distribution." ;
            sh:minCount 1 ;
            sh:node :Distribution_Shape ;
            sh:path dcat:distribution ;
            sh:severity sh:Violation ],
        [ sh:message "Each dcat:Dataset must have at least one dct:identifier." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dcterms:identifier ;
            sh:severity sh:Violation ],
        [ sh:maxCount 1 ;
            sh:message "Each dcat:Dataset may have at most one dct:publisher." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path dcterms:publisher ;
            sh:severity sh:Violation ],
        [ sh:message "dct:publisher must conform to the :HealthPublisherAgent_Shape, which requires exactly one cv:contactPoint, at most one dct:description" ;
            sh:node :HealthPublisherAgent_Shape ;
            sh:path dcterms:publisher ;
            sh:severity sh:Violation ],
        [ sh:node :Distribution_Shape ;
            sh:path adms:sample ;
            sh:severity sh:Violation ],
        [ sh:message "Each dcat:Dataset must have at least one dcat:theme." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dcat:theme ;
            sh:severity sh:Violation ],
        [ sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path dpv:hasPurpose ;
            sh:severity sh:Violation ],
        [ sh:maxCount 1 ;
            sh:message "Each dcat:Dataset must have exactly one healthdcatap:hdab" ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path healthdcatap:hdab ;
            sh:severity sh:Violation ],
        [ sh:message "healthdcatap:hdab must conform to the :HealthAgent_Shape, which requires exactly one cv:contactPoint." ;
            sh:node :HealthAgent_Shape ;
            sh:path healthdcatap:hdab ;
            sh:severity sh:Violation ],
        [ sh:maxCount 1 ;
            sh:message "Each dcat:Dataset may have at most one geodcatap:custodian." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path geodcatap:custodian ;
            sh:severity sh:Violation ],
        [ sh:message "geodcatap:custodian (Data holder) must conform to the :HealthAgent_Shape, which requires exactly one cv:contactPoint." ;
            sh:node :HealthAgent_Shape ;
            sh:path geodcatap:custodian ;
            sh:severity sh:Violation ],
        [ sh:message "Each dcat:Dataset must have at least one healthdcatap:healthCategory." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path healthdcatap:healthCategory ;
            sh:severity sh:Violation ],
        [ sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path healthdcatap:healthTheme ;
            sh:severity sh:Violation ],
        [ sh:path dpv:hasLegalBasis ;
            sh:severity sh:Violation ],
        [ sh:path dpv:hasPersonalData ;
            sh:severity sh:Violation ],
        [ sh:path dqv:hasQualityAnnotation ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "Each dcat:Dataset must have exactly one healthdcatap:hasStructuredData as an xsd:boolean." ;
            sh:minCount 1 ;
            sh:path healthdcatap:hasStructuredData ;
            sh:severity sh:Violation ],
        [ sh:message "Each healthdcatap:hasVariables value must conform to :CSVWTableGroup_Shape." ;
            sh:node :CSVWTableGroup_Shape ;
            sh:path healthdcatap:hasVariables ;
            sh:severity sh:Violation ],
        [ sh:node :Distribution_Shape ;
            sh:path healthdcatap:analytics ;
            sh:severity sh:Violation ],
        [ sh:nodeKind sh:Literal ;
            sh:path healthdcatap:hasCodeValues ;
            sh:severity sh:Violation ],
        [ sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path healthdcatap:hasCodingSystem ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:message "Each dcat:Dataset must have at most one healthdcatap:minTypicalAge as a xsd:nonNegativeInteger." ;
            sh:path healthdcatap:minTypicalAge ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:message "Each dcat:Dataset must have at most one healthdcatap:maxTypicalAge as a xsd:nonNegativeInteger." ;
            sh:path healthdcatap:maxTypicalAge ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:message "Each dcat:Dataset must have at most one healthdcatap:numberOfRecords as a xsd:nonNegativeInteger." ;
            sh:path healthdcatap:numberOfRecords ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:message "Each dcat:Dataset must have at most one healthdcatap:numberOfUniqueIndividuals as a xsd:nonNegativeInteger." ;
            sh:path healthdcatap:numberOfUniqueIndividuals ;
            sh:severity sh:Violation ],
        [ sh:nodeKind sh:Literal ;
            sh:path healthdcatap:populationCoverage ;
            sh:severity sh:Violation ],
        [ sh:nodeKind sh:Literal ;
            sh:path dcterms:alternative ;
            sh:severity sh:Violation ],
        [ sh:maxCount 1 ;
            sh:message "Each dcat:Dataset must have at most one healthdcatap:retentionPeriod as a dct:PeriodOfTime." ;
            sh:node :PeriodOfTime_Shape ;
            sh:path healthdcatap:retentionPeriod ;
            sh:severity sh:Violation ],
        [ sh:message "Each dcat:Dataset must have at least one dcat:contactPoint." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path dcat:contactPoint ;
            sh:severity sh:Violation ],
        [ sh:message "Each dcat:Dataset must have at least one dcat:keyword." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dcat:keyword ;
            sh:severity sh:Violation ],
        [ sh:message "Each dcat:Dataset must have at least one dct:type." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path dcterms:type ;
            sh:severity sh:Violation ],
        [ sh:message "Each dcat:Dataset must have at least one dct:provenance." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path dcterms:provenance ;
            sh:severity sh:Violation ],
        [ sh:hasValue <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ;
            sh:maxCount 1 ;
            sh:message "Each Dataset must have exactly one dct:accessRights, and its value must be http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC." ;
            sh:minCount 1 ;
            sh:path dcterms:accessRights ;
            sh:severity sh:Violation ],
        [ sh:message "Each dcat:Dataset must have at least one dcatap:applicableLegislation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dcatap:applicableLegislation ;
            sh:severity sh:Violation ] ;
    sh:targetClass dcat:Dataset .

:Kind_Shape a sh:NodeShape ;
    rdfs:label "vcard Kind" ;
    rdfs:comment "vcard Kind must have at least one of vcard:hasURL or vcard:hasEmail as an IRI" ;
    sh:property [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vcard:hasURL ;
            sh:severity sh:Violation ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vcard:hasEmail ;
            sh:severity sh:Violation ],
        [ sh:message "Provide at least one of vcard:hasURL or vcard:hasEmail as an IRI." ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( vcard:hasURL vcard:hasEmail ) ] ;
            sh:severity sh:Violation ] ;
    sh:targetClass vcard:Kind .

:TemporalEntity_Shape a sh:NodeShape ;
    rdfs:label "Temporal Entity" ;
    rdfs:comment "Temporal Entity constraints for opening hours" ;
    sh:property [ sh:message "Each time:TemporalEntity must have at least one dct:description as a literal." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dcterms:description ;
            sh:severity sh:Violation ],
        [ sh:class dcterms:Frequency ;
            sh:message "cv:frequency must be an IRI referencing a dct:Frequency from the EU frequency vocabulary." ;
            sh:nodeKind sh:IRI ;
            sh:path cv:frequency ;
            sh:severity sh:Violation ] ;
    sh:targetClass time:TemporalEntity .

<eli:LegalResource> a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:LegalResource](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#LegalResource)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path <https://w3id.org/nfdi-de/dcat-ap-plus/id> ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ] ;
    sh:targetClass <eli:LegalResource> .

default1:AvailabilityRestriction a sh:NodeShape ;
    rdfs:label "Availability restriction" ;
    rdfs:comment "Availability restriction" ;
    sh:property [ sh:hasValue <http://publications.europa.eu/resource/authority/planned-availability> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path skos:inScheme ] .

default1:ChecksumAlgorithmRestriction a sh:NodeShape ;
    rdfs:label "Checksum algorithm restriction" ;
    rdfs:comment "Checksum algorithm restriction" ;
    sh:class spdx:ChecksumAlgorithm .

default1:ConformsToRestriction a sh:NodeShape ;
    rdfs:label "Established standard (FHIR, CDA ...) restriction" ;
    rdfs:comment "Established standard (FHIR, CDA ...) restriction" ;
    sh:property [ sh:class skos:ConceptScheme ;
            sh:hasValue <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/standard> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path skos:inScheme ] .

default1:CorporateBodyRestriction a sh:NodeShape ;
    rdfs:label "Corporate Body Restriction" ;
    rdfs:comment "Corporate Body Restriction" ;
    sh:property [ sh:hasValue <http://publications.europa.eu/resource/authority/corporate-body> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path skos:inScheme ] .

default1:DataThemeRestriction a sh:NodeShape ;
    rdfs:label "Data Theme Restriction" ;
    rdfs:comment "Data Theme Restriction" ;
    sh:property [ sh:hasValue <http://publications.europa.eu/resource/authority/data-theme> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path skos:inScheme ] .

default1:DatasetTypeRestriction a sh:NodeShape ;
    rdfs:label "Dataset Type Restriction" ;
    rdfs:comment "Dataset Type Restriction" ;
    sh:property [ sh:hasValue <http://publications.europa.eu/resource/authority/dataset-type> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path skos:inScheme ] .

default1:HasCodingSystemRestriction a sh:NodeShape ;
    rdfs:label "Coding systems in use (ex: ICD-10-CM, DGRs, SNOMED=CT, ...) restriction" ;
    rdfs:comment "Coding systems in use (ex: ICD-10-CM, DGRs, SNOMED=CT, ...) restriction" ;
    sh:property [ sh:class skos:ConceptScheme ;
            sh:hasValue <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/coding-system> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path skos:inScheme ] .

default1:HealthActivityRestriction a sh:NodeShape ;
    rdfs:label "Health activities restriction" ;
    rdfs:comment "Health activities restriction" ;
    sh:property [ sh:class skos:ConceptScheme ;
            sh:hasValue <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-activity> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path skos:inScheme ] .

default1:HealthActivity_ShapeCV a sh:NodeShape ;
    rdfs:label "Health Activity"@en ;
    sh:property [ sh:description "A non-EU managed concept is used to indicate the health activity type. Please align with a concept from https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-activity. If no match is found, inform the maintainer of the EU health-activity NAL." ;
            sh:node default1:HealthActivityRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:type ;
            sh:severity sh:Violation ] .

default1:HealthCategoryRestriction a sh:NodeShape ;
    rdfs:label "Health Category restriction" ;
    rdfs:comment "Health Category restriction" ;
    sh:property [ sh:class skos:ConceptScheme ;
            sh:hasValue <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path skos:inScheme ] .

default1:HealthPublisherAgent_ShapeCV a sh:NodeShape ;
    rdfs:label "Health Publisher Agent"@en ;
    sh:property [ sh:description "A non-EU managed concept is used to indicate the publisher type. Please align with a concept from https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/publisher-type. If no match is found, inform the maintainer of the EU publisher-type NAL." ;
            sh:node default1:HealthPublisherTypeRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:type ;
            sh:severity sh:Violation ] .

default1:HealthPublisherTypeRestriction a sh:NodeShape ;
    rdfs:label "Publisher Types for EHDS Restriction" ;
    rdfs:comment "Publisher Types for EHDS Restriction" ;
    sh:property [ sh:hasValue <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/publisher-type> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path skos:inScheme ] .

default1:HealthThemeRestriction a sh:NodeShape ;
    rdfs:label "Health theme restriction" ;
    rdfs:comment "Health theme restriction" ;
    sh:property [ sh:class skos:ConceptScheme ;
            sh:hasValue <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-theme> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path skos:inScheme ] .

default1:LicenceTypeRestriction a sh:NodeShape ;
    rdfs:label "Licence type restriction" ;
    rdfs:comment "Licence type restriction" ;
    sh:property [ sh:hasValue <http://purl.org/adms/licencetype/1.0> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path skos:inScheme ] .

default1:PublisherTypeRestriction a sh:NodeShape ;
    rdfs:label "Publisher type restriction" ;
    rdfs:comment "Publisher type restriction" ;
    sh:property [ sh:class skos:ConceptScheme ;
            sh:hasValue <http://purl.org/adms/publishertype/1.0> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path skos:inScheme ] .

default1:Publisher_ShapeCV a sh:NodeShape ;
    sh:property [ sh:description "A non EU managed concept is used to indicate the type of the publisher. If no corresponding can be found inform the maintainer of the adms:publishertype codelist." ;
            sh:node default1:PublisherTypeRestriction ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:type ;
            sh:severity sh:Violation ] .

default1:StatusRestriction a sh:NodeShape ;
    rdfs:label "Status restriction" ;
    rdfs:comment "Status restriction" ;
    sh:property [ sh:class skos:ConceptScheme ;
            sh:hasValue <http://publications.europa.eu/resource/authority/distribution-status> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path skos:inScheme ] .

dcterms:Location a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Location](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Location)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The geographic center (centroid) of a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcat:centroid ],
        [ sh:datatype xsd:string ;
            sh:description "The geographic bounding box of a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcat:bbox ],
        [ sh:class lcon:Geometry ;
            sh:description "The corresponding geometry for a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path lcon:geometry ] ;
    sh:targetClass dcterms:Location .

dcterms:ProvenanceStatement a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:ProvenanceStatement](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#ProvenanceStatement)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ] ;
    sh:targetClass dcterms:ProvenanceStatement .

time:Instant a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:TimeInstant](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#TimeInstant)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass time:Instant .

dcat:Relationship a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Relationship](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Relationship)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <rdfs:Resource> ;
            sh:description "A resource related to the source resource." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dcterms:relation ],
        [ sh:class dcat:Role ;
            sh:description "A function of an entity or agent with respect to another entity or resource." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dcat:hadRole ] ;
    sh:targetClass dcat:Relationship .

odrl:Policy a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Policy](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Policy)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass odrl:Policy .

prov:Attribution a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Attribution](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Attribution)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ),
        ( rdf:type dcat:hadRole prov:agent ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:class foaf:Agent ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path prov:agent ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:description ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dcat:hadRole ] ;
    sh:targetClass prov:Attribution .

foaf:Document a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Document](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Document)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path <https://w3id.org/nfdi-de/dcat-ap-plus/id> ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ] ;
    sh:targetClass foaf:Document .

<https://semiceu.github.io/DCAT-AP/releases/3.0.0/html/shacl/range.ttl> a owl:Ontology ;
    owl:imports <https://semiceu.github.io/DCAT-AP/releases/3.0.0/html/shacl/range.ttl> .

<https://semiceu.github.io/DCAT-AP/releases/3.0.0/html/shacl/shapes.ttl> a owl:Ontology ;
    owl:imports <https://semiceu.github.io/DCAT-AP/releases/3.0.0/html/shacl/shapes.ttl> .

:CSVWColumnShape a sh:NodeShape ;
    sh:property [ sh:message "Each csvw:Column must have at least one name (csvw:name) as a literal." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path csvw:name ],
        [ sh:message "Each csvw:Column must have at least one description (dct:description) as a literal." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dcterms:description ],
        [ sh:message "Each csvw:Column must have at least one title (csvw:titles) as a literal." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path csvw:titles ],
        [ sh:maxCount 1 ;
            sh:message "Each csvw:Column must have exactly one datatype (csvw:datatype) as a literal (e.g., 'string', 'integer'). See https://w3c.github.io/csvw/metadata/#datatypes" ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path csvw:datatype ],
        [ sh:maxCount 1 ;
            sh:message "Each csvw:Column may have at most one property URL (csvw:propertyUrl), which must be a valid IRI referencing a semantic property." ;
            sh:nodeKind sh:IRI ;
            sh:path csvw:propertyUrl ;
            sh:severity sh:Violation ] ;
    sh:targetClass csvw:Column .

:CSVWTableGroup_Shape a sh:NodeShape ;
