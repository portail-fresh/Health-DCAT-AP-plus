            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass <https://w3id.org/nfdi-de/dcat-ap-plus/SupportiveEntity> .

